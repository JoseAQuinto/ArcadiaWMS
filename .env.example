# =============================================================================
# Arcadia WMS - Environment variables
# =============================================================================
# Copy this file to .env (local development) and fill in real values.
# In Vercel, configure the same variables under Project Settings > Environment
# Variables. NEVER commit a real .env file.
#
# All variables below are server-side only. None of them are prefixed with
# VITE_, so none of them are ever bundled into the frontend or exposed to the
# browser. The frontend talks to the backend exclusively through same-origin
# relative requests to /api/*, so no public API URL needs to be configured.
# =============================================================================

# PostgreSQL connection string from your Neon project.
# Neon dashboard -> Project -> Connection Details -> "Pooled connection".
# Example: postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secret used to sign and verify JWT session tokens. Use a long, random
# string (e.g. `openssl rand -base64 48`). Rotating it invalidates all
# existing sessions.
JWT_SECRET=

# Optional: how long a login session stays valid. Accepts values understood
# by the `jsonwebtoken` library (e.g. "8h", "1d"). Defaults to 8h if unset.
JWT_EXPIRES_IN=8h
